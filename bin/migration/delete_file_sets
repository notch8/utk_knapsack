#!/usr/bin/env ruby
# frozen_string_literal: true

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('Gemfile', __dir__)
require 'bundler/setup'
require 'optparse'
require_relative 'lib/migration'

$stdout.sync = true

module Migration
  BANNER = 'usage: bin/migration/delete_file_sets tmp/migration/sheets/<name>.csv ' \
           '[--dev|--staging|--prod] [--tenant CNAME] [--email E] [--apply] [--yes]'

  options = { email: 'admin@example.com' }
  begin
    OptionParser.new(BANNER) do |o|
      Options::TARGETS.each do |flag, name|
        o.on("--#{flag}") do
          abort '🛑 Pick one of --dev, --staging, --prod' if options[:target]
          options[:target] = name
        end
      end
      o.on('--tenant CNAME') { |cname| options[:tenant] = cname }
      o.on('--email E', 'the user the deletes are recorded as (default admin@example.com)') { |e| options[:email] = e }
      o.on('--apply', 'delete; without it, only list what would be deleted') { options[:apply] = true }
      o.on('-y', '--yes', 'skip the confirmation prompt on prod') { options[:yes] = true }
    end.parse!(ARGV)
  rescue OptionParser::ParseError => e
    abort "🛑 #{e.message}\n#{BANNER}"
  end
  abort BANNER if ARGV.empty?

  path = File.expand_path(ARGV[0])
  target = Target.for(options[:target])
  tenant = options[:tenant] || abort('🛑 Pass --tenant')
  app = target.pod ? Pod.new(target.pod) : LocalApp.new('local')

  if options[:apply] && target.name == 'production' && !options[:yes]
    abort '🛑 No terminal to confirm on; pass --yes to delete without the prompt.' unless $stdin.tty?
    print "Delete the file sets #{File.basename(path)} names from #{tenant}? Type prod to proceed: "
    abort 'Cancelled.' unless $stdin.gets.to_s.strip.casecmp('prod').zero?
  end

  output = []
  status = app.run('delete_file_sets', tenant, options[:email], options[:apply] ? 'apply' : 'list',
                   stdin: File.read(path, encoding: 'bom|utf-8'), ruby: 'bundle exec rails runner') do |line|
    line.start_with?('MARKER ') ? puts(line.delete_prefix('MARKER ')) : output << line
  end
  exit if status.success?

  warn output.reject { |line| line.start_with?('** ', "\tfrom ") }.last(20).join
  exit 1
end
